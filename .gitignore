# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Local scratch output produced by scripts
scripts/output/
*.log
logs/
tmp/
temp/

# Generated charts and reports (users generate these locally)
outputs/charts/*
outputs/reports/*
!outputs/charts/.gitkeep
!outputs/reports/.gitkeep
