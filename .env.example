# Financial Market Intelligence — 环境变量示例
#
# 本阶段 MVP 不需要任何 API Key：新浪财经、AKShare、yfinance 都是免费公开数据源。
# 该文件仅为可选的运行参数覆盖，复制为 .env 后按需修改。
#
# 注意：项目本身不会自动加载 .env，请在 shell 中显式导出环境变量
#（或由 MCP 宿主在启动配置里传入），详见 README「Harness 接入」。

# ---------------------------------------------------------------- 网络 ----

# 所有数据源请求的统一超时（秒）
FMI_REQUEST_TIMEOUT=10

# ---------------------------------------------------------------- 缓存 ----

# 报价内存缓存有效期（秒）；命中时 from_cache=true，但行情时间 timestamp 不会被刷新
FMI_CACHE_TTL=60

# 历史行情内存缓存有效期（秒）
FMI_HISTORY_CACHE_TTL=300

# ------------------------------------------------------------ 历史数据 ----

# 单次返回的最大 bar 数（超出时保留最近 N 条并标注 truncated=true）
FMI_MAX_HISTORY_ROWS=1500

# 行情时间超过多少天视为 stale（免费源可能停更/停牌）
FMI_STALE_AFTER_DAYS=10

# ---------------------------------------------------------------- 数据源 ----

# 数据源开关（true / false）
FMI_ENABLE_SINA=true
FMI_ENABLE_AKSHARE=true
FMI_ENABLE_YFINANCE=true

# 数据源尝试顺序（逗号分隔）：先请求谁，失败再回退到下一个
# 报价主要由 sina 提供，历史主要由 akshare 提供，yfinance 作为可移植回退
FMI_PROVIDER_ORDER=sina,akshare,yahoo

# ---------------------------------------------------------------- 日志 ----

# 日志级别：DEBUG / INFO / WARNING / ERROR（日志只写 stderr，绝不污染 stdio 协议）
FMI_LOG_LEVEL=INFO
